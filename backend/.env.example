# AutoScientist AI Backend Configuration Template
# Copy this file to .env or set environment variables in your deployment environment

SERVER_PORT=8080
# Local development only: SPRING_PROFILES_ACTIVE=dev
# Staging/production uses MySQL + Flyway:
SPRING_PROFILES_ACTIVE=mysql

# Database Configuration
# For local dev with profile 'dev', H2 file DB is used by default (see application.yml).
# For profile 'mysql', supply MySQL connection details (no defaults in the mysql profile).
# Use a managed MySQL 8.0 database; append TLS options as required by the provider.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/autoscientist_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=your_db_username
# SPRING_DATASOURCE_PASSWORD=your_db_password
# mysql production: Flyway owns changes; Hibernate validates by default.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Security & JWT (HS256). For mysql profile, JWT_SECRET is required (base64, >= 64 bytes decoded).
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=REPLACE_WITH_BASE64_JWT_SECRET
JWT_EXPIRATION_MS=86400000

# Browser CORS origin(s), comma-separated. Required (no default) in mysql profile.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# File Storage
# In Docker use /app/uploads/datasets and mount a persistent disk at /app/uploads.
# Required (no fallback) in mysql profile.
FILE_UPLOAD_DIR=./uploads/datasets
MAX_FILE_SIZE_MB=50

# Password reset delivery
# The reset link points at FRONTEND_URL/reset-password?token=...
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FROM=no-reply@autoscientist.local
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MIN_INTERVAL_SECONDS=60
# Dev-only fallback: write .eml files to a local outbox when SMTP is unavailable.
# Keep false in staging/production.
PASSWORD_RESET_OUTBOX_ENABLED=false
PASSWORD_RESET_OUTBOX_DIR=./data/mail-outbox

# SMTP (required in production for reset emails to be delivered)
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_smtp_username
# SPRING_MAIL_PASSWORD=your_smtp_password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
