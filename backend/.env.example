# AutoScientist AI Backend Configuration Template
# Copy this file to .env or set environment variables in your deployment environment

SERVER_PORT=8080
# Local development only: SPRING_PROFILES_ACTIVE=dev
# Staging/production uses MySQL + Flyway:
SPRING_PROFILES_ACTIVE=mysql

# Database Configuration
# For local dev with profile 'dev', H2 file DB is used by default (see application.yml).
# For profile 'mysql', supply MySQL connection details (no defaults in the mysql profile).
# Aiven JDBC URL: keep TLS enabled. REQUIRED encrypts traffic; prefer VERIFY_CA
# or VERIFY_IDENTITY when the Aiven CA trust configuration is available.
# SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-host>:<port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=your_db_username
# SPRING_DATASOURCE_PASSWORD=your_db_password
# mysql production: Flyway owns changes; Hibernate validates by default.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Security & JWT (HS256). For mysql profile, JWT_SECRET is required (base64, >= 64 bytes decoded).
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=REPLACE_WITH_BASE64_JWT_SECRET
JWT_EXPIRATION_MS=86400000

# Browser CORS origin(s), comma-separated. Required (no default) in mysql profile.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# Dataset Storage Backend
# ──────────────────────────────────────────────────────────────────────────────
#
# Choose ONE of the two storage modes below:
#
# OPTION A — Cloudflare R2 (recommended for Render free tier; survives redeploys)
# ----------------------------------------------------------------------------
# Files are stored in Cloudflare R2 object storage (S3-compatible, free tier
# includes 10 GB/month storage and 10 million read operations).
# Steps to configure:
#   1. Create a Cloudflare account → R2 Object Storage → Create bucket.
#   2. Generate an API token with "Object Read & Write" on that bucket.
#   3. Set the five S3 variables below in your Render environment.
#
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=autoscientist-datasets
# STORAGE_S3_ENDPOINT=https://<YOUR_CF_ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY=<R2 Access Key ID>
# STORAGE_S3_SECRET_KEY=<R2 Secret Access Key>
#
# When STORAGE_BACKEND=s3, FILE_UPLOAD_DIR is unused.  You can omit it or
# leave it at the default (/app/uploads/datasets) — the S3 backend ignores it.
#
# OPTION B — Local filesystem (Render Persistent Disk, $0.25/GB/month)
# ----------------------------------------------------------------------------
# STORAGE_BACKEND=local
# FILE_UPLOAD_DIR=/app/uploads/datasets
# Then add a Render Disk mounted at /app/uploads.
#
# Default (development):
STORAGE_BACKEND=local
FILE_UPLOAD_DIR=./uploads/datasets

# Password reset delivery
# The reset link points at FRONTEND_URL/reset-password?token=...
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FROM=no-reply@autoscientist.local
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MIN_INTERVAL_SECONDS=60
# Dev-only fallback: write .eml files to a local outbox when SMTP is unavailable.
# Keep false in staging/production.
PASSWORD_RESET_OUTBOX_ENABLED=false
PASSWORD_RESET_OUTBOX_DIR=./data/mail-outbox

# SMTP (required in production for reset emails to be delivered)
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_smtp_username
# SPRING_MAIL_PASSWORD=your_smtp_password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_CHECKSERVERIDENTITY=true
