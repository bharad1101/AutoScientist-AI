# AutoScientist AI Frontend Configuration Template
# Copy this file to .env or .env.local for LOCAL DEVELOPMENT.
#
# PRODUCTION (Vercel):
#   Set VITE_API_BASE_URL as a BUILD-TIME environment variable in the Vercel
#   project's Production environment. Vite bakes this value into the bundle at
#   build time — it cannot be changed at runtime after the build.
#
#   Example Vercel build env var:
#     VITE_API_BASE_URL=https://autoscientist-ai-backend.onrender.com/api
#
#   WARNING: Production builds now fail if VITE_API_BASE_URL is missing,
#   relative, non-HTTPS, or points to localhost/loopback. This prevents a
#   localhost URL from being baked into the deployed bundle.
#
#   Local development does not need this variable: /api is proxied by Vite.
#     VITE_API_BASE_URL=http://localhost:8080/api
#
#   Production build (required):
#     VITE_API_BASE_URL=https://your-backend-host.example.com/api

VITE_APP_TITLE=AutoScientist AI
