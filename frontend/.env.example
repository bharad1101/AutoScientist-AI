# AutoScientist AI Frontend Configuration Template
# Copy this file to .env or .env.local for LOCAL DEVELOPMENT only.
# Never put production secrets in frontend environment variables; Vite bakes
# every VITE_* value into the public bundle at build time.

# LOCAL DEVELOPMENT
# Vite runs on http://localhost:5173 and proxies /api to http://localhost:8080.
# Keep /api relative so requests use the dev proxy and avoid CORS.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=45000
VITE_APP_TITLE=AutoScientist AI

# PRODUCTION — OPTION A: separate frontend and backend deployments
# Set this at BUILD TIME in the hosting provider's Production environment.
# Supply the real backend host from the provider dashboard; do not assume the
# placeholder below is deployed.
#   VITE_API_BASE_URL=https://<your-production-api-host>/api

# PRODUCTION — OPTION B: same-origin reverse proxy
# Use this only when the host genuinely routes /api to the backend (for example
# the Nginx reverse proxy documented in docs/DEPLOYMENT.md). Both variables are
# required; the build rejects /api without the explicit opt-in.
#   VITE_API_BASE_URL=/api
#   VITE_API_PROXY_MODE=same-origin

# Production builds fail with a clear error when the API base URL is missing,
# invalid, non-HTTPS, localhost/loopback, credentialed, query/fragment-bearing,
# non-443-port, or missing the /api suffix. There is no silent localhost fallback.
