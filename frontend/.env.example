# AutoScientist AI Frontend Configuration Template
# Copy this file to .env or .env.local for LOCAL DEVELOPMENT.
#
# PRODUCTION (Render):
#   Set VITE_API_BASE_URL as a BUILD-TIME environment variable on your Render
#   Static Site or Web Service. Vite bakes this value into the bundle at build
#   time — it cannot be changed at runtime after the build.
#
#   Example Render build env var:
#     VITE_API_BASE_URL=https://autoscientist-ai-backend.onrender.com/api
#
#   WARNING: Do NOT leave VITE_API_BASE_URL pointing to localhost in a
#   production build. If VITE_API_BASE_URL is absent at build time the
#   frontend falls back to /api (relative URL), which is safe when frontend
#   and backend are served from the same origin. An absolute localhost URL
#   baked into the bundle will cause all API calls to fail in production.

VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE=AutoScientist AI
